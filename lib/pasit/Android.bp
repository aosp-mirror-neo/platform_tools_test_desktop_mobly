package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_library_host {
    name: "py-pasit-camera",
    srcs: [
        "*/*camera.py",
        "*camera.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-device",
    srcs: [
        "*/*device.py",
        "*device.py",
        "dut_state_manager.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
        "py-desktop-utils",
        "py-pasit-servo-client",
        "py-snippet-uiautomator",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-display",
    srcs: [
        "*/*display.py",
        "*display.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-file",
    srcs: [
        "*/*file.py",
        "*file.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-servo-client",
    srcs: [
        "base/servo_client.py",
    ],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-storage",
    srcs: [
        "*/*storage.py",
        "*storage.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-test",
    srcs: [
        "*/*test.py",
        "*test.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
        "py-pasit-device",
        "py-passport",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-passport",
    srcs: ["passport/*.py"],
    libs: [
        "py-grpcio",
        "libprotobuf-python",
        "mobly",
        "py-chromiumos-config-passport",
    ],
    pkg_path: "lib/pasit",
}
