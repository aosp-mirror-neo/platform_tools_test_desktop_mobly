package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_desktop_peripherals",
}

python_library_host {
    name: "tradefed_arg_wrap",
    srcs: ["tradefed_arg_wrap.py"],
}

python_test_host {
    name: "ExternalImportTest",
    main: "external_import_test.py",
    srcs: ["external_import_test.py"],
    // Additional libraries to be included directly in the executable.
    libs: ["tradefed_arg_wrap"],
    test_config: "external_import_test.xml",
    // Must use embedded_launcher: false to use the local interpreter otherwise
    // .par file won't be able to pick up virtualenv libraries.
    embedded_launcher: false,
    test_options: {
        unit_test: false,
    },
    // Additional .apk's to be installed on the Android host.
    // Right now, they are installed with a TF preparer.
    device_common_data: [
        // test apk module
        ":mobly-bundled-snippets",
    ],
    test_suites: [
        "general-tests",
    ],
}
