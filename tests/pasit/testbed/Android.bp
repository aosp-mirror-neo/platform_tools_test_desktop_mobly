package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_test_host {
    name: "DesktopPASITTestbedTests",
    main: "pasit_testbed_suite.py",
    srcs: ["*.py"],
    exclude_srcs: ["pasit_testbed_import_test.py"],
    defaults: ["PASIT-defaults"],
    test_options: {
        unit_test: false,
        runner: "mobly",
        tags: ["mobly"],
    },
    device_common_data: [
        // test APK module
        ":mobly-bundled-snippets",
        ":snippet-uiautomator",
        ":ColorFillTest",
        ":HidDeviceSnippet",
    ],
    libs: [
        "py-pasit-storage",
        "py-pasit-camera",
        "py-pasit-display",
        "py-pasit-hid",
        "py-pasit-network",
        "py-display-helper",
        "py-display-painter",
        "py-display-camera-mapper",
        "py-peripheral-connector",
    ],
    pkg_path: "pasit/testbed",
}

python_test_host {
    name: "pasit_testbed_import_test",
    srcs: [
        "pasit_testbed_import_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "DesktopPASITTestbedTests",
    ],
}
